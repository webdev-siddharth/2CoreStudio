{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "senior-design-director": {
      "type": "local",
      "command": ["npx", "-y", "senior-design-director-mcp"],
      "enabled": true
    },
    "magicui": {
      "type": "local",
      "command": ["npx", "-y", "@magicuidesign/mcp@latest"],
      "enabled": true
    },
    "threejs-devtools": {
      "type": "local",
      "command": ["npx", "-y", "threejs-devtools-mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser", "msedge"],
      "enabled": true
    },
    "windframe": {
      "type": "remote",
      "url": "https://mcp.windframe.dev/mcp",
      "enabled": false
    }
  }
}
